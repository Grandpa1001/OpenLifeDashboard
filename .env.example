# The .env of an OpenLifeDashboard installation (Architektura §14.4, §14.5, §12.2). The installer (install/install.sh, install/install.ps1) writes
# this file once, with new keys, mode 600; it is never edited by the application and never committed. This example documents every key: a key with a
# value here is written by the installer, a commented one is optional and shown with its default. The secrets are empty on purpose: the installer
# generates them (32 random bytes as 64 hex digits) and nothing here may be copied into a real installation.

# ---- The installation (written by the installer)
# local: the application is published only on 127.0.0.1:PORT. server: only Caddy is published, on ports 80 and 443.
INSTALL_MODE=local
# The address the owner opens, without a path: http://localhost:PORT in the local mode, https://DOMAIN in the server mode.
BASE_URL=http://localhost:8080
# The two keys are different. Without them the data cannot be opened: copy this file to a safe place.
BETTER_AUTH_SECRET=
APP_ENCRYPTION_KEY=
# The host user of the installation: the folders ./data and ./control belong to it, and the application runs as it (never root).
APP_UID=1000
APP_GID=1000
# One Compose project per installation; the files are listed with the separator below, the release file last.
COMPOSE_PROJECT_NAME=openlife-000000000000
COMPOSE_PATH_SEPARATOR=;
COMPOSE_FILE=compose.yml;compose.local.yml;control/compose.release.yml
# The updater is not part of the installer yet; false is the only supported value.
UPDATER_ENABLED=false

# ---- The local mode
# The port of the host (1024 to 65535), published on 127.0.0.1 only. The application inside the container always listens on 8080.
PORT=8080

# ---- The server mode (instead of PORT and compose.local.yml, with compose.server.yml)
# DOMAIN=dziennik.example.com
# The address the certificate authority is given for notices about the certificate.
# ACME_EMAIL=owner@example.com

# ---- The options the application reads from here, when set (Architektura §14.3); a value here beats the one in the settings
# DB_BUSY_TIMEOUT_MS=5000
# BACKUP_DISK_RESERVE_MIB=512
# IMPORT_MAX_MIB=100
# RECORD_MAX_KIB=192
# JSON_BODY_KIB=256

# ---- The updater (installed with compose.updater.yml; not part of the installer yet)
# UPDATER_TOKEN=
# RELEASES_REPO=owner/OpenLifeDashboard
# The base of the API of the releases when the installation does not use GitHub itself (a mirror).
# RELEASES_API_URL=
# The group of the Docker socket of the host, 0 on Docker Desktop.
# DOCKER_GID=0
# How long the updater waits for the new version to become healthy, in whole seconds; empty means the protocol's 180 s.
# UPDATER_START_TIMEOUT_SECONDS=
