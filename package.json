{
  "name": "openlifedashboard",
  "version": "0.0.0",
  "author": "Kamil Bandzwołek",
  "private": true,
  "description": "Self-hosted, no-code personal life dashboard.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "24.22.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc -b && tsc -p tsconfig.tooling.json",
    "lint": "eslint .",
    "check:architecture": "node scripts/check-architecture.ts",
    "check:contracts": "node scripts/check-contracts.ts"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "dependency-cruiser": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
