  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": [
    "scripts",
    "tests",
    "tooling",
    "vitest.config.ts",
    "playwright.config.ts",
    "apps/web/vite.config.ts"
  ]
}
