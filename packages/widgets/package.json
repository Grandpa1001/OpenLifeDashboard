{
  "name": "@openlife/widgets",
  "version": "0.0.0",
  "private": true,
  "description": "Widget type manifests (definitions) and views, exported separately.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./definitions": {
      "@openlife/source": "./src/definitions.ts",
      "types": "./dist/definitions.d.ts",
      "default": "./dist/definitions.js"
    },
    "./views": {
      "@openlife/source": "./src/views.ts",
      "types": "./dist/views.d.ts",
      "default": "./dist/views.js"
    }
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@openlife/contracts": "workspace:*",
    "react": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "typescript": "catalog:"
  }
}
