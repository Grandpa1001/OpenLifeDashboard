{
  "name": "@openlife/sqlite",
  "version": "0.0.0",
  "private": true,
  "description": "SQLite connection, schema, migrations and core port adapters.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./adapters/audit": {
      "@openlife/source": "./src/adapters/audit/append-audit.ts",
      "types": "./dist/adapters/audit/append-audit.d.ts",
      "default": "./dist/adapters/audit/append-audit.js"
    },
    "./adapters/dashboard": {
      "@openlife/source": "./src/adapters/dashboard/public.ts",
      "types": "./dist/adapters/dashboard/public.d.ts",
      "default": "./dist/adapters/dashboard/public.js"
    },
    "./adapters/identity": {
      "@openlife/source": "./src/adapters/identity/public.ts",
      "types": "./dist/adapters/identity/public.d.ts",
      "default": "./dist/adapters/identity/public.js"
    },
    "./adapters/registries": {
      "@openlife/source": "./src/adapters/registries/public.ts",
      "types": "./dist/adapters/registries/public.d.ts",
      "default": "./dist/adapters/registries/public.js"
    },
    "./adapters/settings": {
      "@openlife/source": "./src/adapters/settings/public.ts",
      "types": "./dist/adapters/settings/public.d.ts",
      "default": "./dist/adapters/settings/public.js"
    },
    "./connection": {
      "@openlife/source": "./src/connection/open-database.ts",
      "types": "./dist/connection/open-database.d.ts",
      "default": "./dist/connection/open-database.js"
    },
    "./driver-probe": {
      "@openlife/source": "./src/driver-probe.ts",
      "types": "./dist/driver-probe.d.ts",
      "default": "./dist/driver-probe.js"
    },
    "./migrations": {
      "@openlife/source": "./src/migrations/public.ts",
      "types": "./dist/migrations/public.d.ts",
      "default": "./dist/migrations/public.js"
    },
    "./schema": {
      "@openlife/source": "./src/schema/table-shape.ts",
      "types": "./dist/schema/table-shape.d.ts",
      "default": "./dist/schema/table-shape.js"
    },
    "./snapshots": {
      "@openlife/source": "./src/snapshots/copy-database.ts",
      "types": "./dist/snapshots/copy-database.d.ts",
      "default": "./dist/snapshots/copy-database.js"
    },
    "./transactions": {
      "@openlife/source": "./src/transactions/unit-of-work.ts",
      "types": "./dist/transactions/unit-of-work.d.ts",
      "default": "./dist/transactions/unit-of-work.js"
    }
  },
  "scripts": {
    "build": "tsc -b"
  },
  "devDependencies": {
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@openlife/core": "workspace:*",
    "better-sqlite3": "catalog:"
  }
}
