{
  "name": "@openlife/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Transport schemas, DTOs and error codes shared by server and web.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./backups/database-snapshot": {
      "@openlife/source": "./src/backups/database-snapshot.ts",
      "types": "./dist/backups/database-snapshot.d.ts",
      "default": "./dist/backups/database-snapshot.js"
    },
    "./http/bootstrap": {
      "@openlife/source": "./src/http/bootstrap.ts",
      "types": "./dist/http/bootstrap.d.ts",
      "default": "./dist/http/bootstrap.js"
    },
    "./http/errors": {
      "@openlife/source": "./src/http/errors.ts",
      "types": "./dist/http/errors.d.ts",
      "default": "./dist/http/errors.js"
    },
    "./http/health": {
      "@openlife/source": "./src/http/health.ts",
      "types": "./dist/http/health.d.ts",
      "default": "./dist/http/health.js"
    },
    "./locales": {
      "@openlife/source": "./src/locales.ts",
      "types": "./dist/locales.d.ts",
      "default": "./dist/locales.js"
    },
    "./settings": {
      "@openlife/source": "./src/settings/catalog.ts",
      "types": "./dist/settings/catalog.d.ts",
      "default": "./dist/settings/catalog.js"
    },
    "./workers/maintenance-state": {
      "@openlife/source": "./src/workers/maintenance-state.ts",
      "types": "./dist/workers/maintenance-state.d.ts",
      "default": "./dist/workers/maintenance-state.js"
    }
  },
  "scripts": {
    "build": "tsc -b"
  },
  "devDependencies": {
    "typescript": "catalog:"
  },
  "dependencies": {
    "zod": "catalog:"
  }
}
